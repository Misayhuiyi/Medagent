    },
    {
      "id": "arch-three-layer",
      "label": "三层架构：Tool 到 kb_manager 到 ChromaDB",
      "type": "architecture",
      "subtype": "layered_pattern",
      "description": "知识库检索三层架构：tool.py (业务逻辑) 到 kb_manager.py (引擎层) 到 ChromaDB (数据持久)。"
    },
    {
      "id": "arch-dual-recall",
      "label": "双路召回策略 (Dual Recall)",
      "type": "architecture",
      "subtype": "retrieval_pattern",
      "description": "同时执行带过滤和无过滤两次向量检索，合并去重。解决 ChromaDB 1.5.x where 不稳定。"
    },
    {
      "id": "arch-hybrid-search",
      "label": "混合检索排序流程",
      "type": "architecture",
      "subtype": "retrieval_pattern",
      "description": "向量检索 (bge-m3) 到 候选合并 到 CrossEncoder 精排 到 融合排序。"
    },
    {
      "id": "arch-multi-org-search",
      "label": "多机构分机构检索",
      "type": "architecture",
      "subtype": "retrieval_pattern",
      "description": "逐机构独立查询 ChromaDB，合并后精排，强制机构多样性均衡。"
    },
    {
      "id": "arch-parent-child-chunking",
      "label": "父子分块 + 段落重叠",
      "type": "architecture",
      "subtype": "chunking_pattern",
      "description": "H2/H3 标题切分，超 500 token 时分段。段落重叠 1 段。"
    },
    {
      "id": "arch-failure-recovery",
      "label": "多层失败恢复机制",
      "type": "architecture",
      "subtype": "resilience_pattern",
      "description": "Ollama 500 重试 到 多级文本降级 到 补偿重试 到 failed_chunks.jsonl 到 retry_failed_chunks()。"
    },
    {
      "id": "arch-tool-registration",
      "label": "双框架工具注册",
      "type": "architecture",
      "subtype": "tool_pattern",
      "description": "同时支持 OpenAI function calling 和 LangChain StructuredTool 格式。"
    }
  ],
