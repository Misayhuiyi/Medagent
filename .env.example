# MedAgent 环境变量配置
# 复制为 .env 并填入真实密钥

# ── LLM API 密钥（至少配置一个） ──
# 通用 LLM（兼容 OpenAI 格式）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# DeepSeek 专用
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI
OPENAI_API_KEY=sk-xxx

# 阿里云 DashScope
DASHSCOPE_API_KEY=sk-xxx

# LLM 供应商选择（大写，如 DEEPSEEK、OPENAI、DASHSCOPE）
LLM_PROVIDER=DEEPSEEK

# ── 服务端口 ──
PORT=8000

# ── Docker 部署（可选） ──
NAS_PATH=./user_data
RESULT_PATH=./results

# ── PDF 报告导出配置（可选） ──
# 默认自动从 PATH 查找浏览器 / wkhtmltopdf，字体自动探测常见路径。
# 如需指定特定路径，取消注释并填写：
# MEDAGENT_CHROMIUM_PATH=
# MEDAGENT_WKHTMLTOPDF_PATH=
# MEDAGENT_FONT_PATH=
